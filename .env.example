APP_NAME=Fashion Intelligence Agent
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/fia.db
CORS_ORIGINS=http://localhost:5173
SEARCH_PROVIDER=demo
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_IMAGES_ENDPOINT=https://api.search.brave.com/res/v1/images/search
SEARCH_RESULT_COUNT=20
CRAWL_USER_AGENT=FIAResearchBot/0.3 (+https://github.com/AryanGupta-234/FIA)
CRAWL_TIMEOUT_SECONDS=8
CRAWL_MAX_BYTES=1500000
CRAWL_MAX_PAGES_PER_JOB=8
CRAWL_RESPECT_ROBOTS=true
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_INTERVAL_MINUTES=360
AUTO_REFRESH_POLL_SECONDS=60

PRICE_STALE_AFTER_HOURS=72
PRICE_ALERT_COOLDOWN_HOURS=24
MIN_PRICE_ALERT_DROP_PERCENT=2.0

# Prixon local Windows agent
PRIXON_OLLAMA_BASE_URL=http://127.0.0.1:11434
PRIXON_OLLAMA_MODEL=qwen2.5:3b-instruct
PRIXON_OLLAMA_TIMEOUT_SECONDS=60
PRIXON_OLLAMA_KEEP_ALIVE=10m
PRIXON_AGENT_AUTOSTART=true
PRIXON_AGENT_MAX_PLAN_STEPS=8
PRIXON_AGENT_WALL_CLOCK_SECONDS=60
PRIXON_AGENT_STEP_TIMEOUT_SECONDS=12
PRIXON_AGENT_MAX_REPLANS=2
PRIXON_AGENT_MAX_MODEL_TOKENS=1024
PRIXON_AGENT_MAX_ACTIONS_PER_MINUTE=20
PRIXON_AGENT_LOOP_POLL_SECONDS=2
PRIXON_SEMANTIC_ENABLED=false
# For multilingual Hindi/Hinglish experiments, try:
# PRIXON_SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PRIXON_SEMANTIC_MODEL_NAME=BAAI/bge-small-en-v1.5
# Voice kill is opt-in. Run scripts/setup-prixon-voice.ps1 to install the local model.
PRIXON_VOICE_KILL_ENABLED=false
PRIXON_VOICE_COMMANDS_ENABLED=false
PRIXON_VOICE_MODEL_PATH=
PRIXON_VOICE_CAPTURE_SECONDS=5
# Chromium/Brave/Edge DevTools diagnostics are read-only, loopback-only and disabled by default.
# Start the browser yourself with --remote-debugging-port=9222 to opt in.
PRIXON_BROWSER_DEBUG_ENABLED=false
PRIXON_BROWSER_DEBUG_PORT=9222
