APP_NAME=Fashion Intelligence Agent
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/fia.db
CORS_ORIGINS=http://localhost:5173
SEARCH_PROVIDER=demo
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_IMAGES_ENDPOINT=https://api.search.brave.com/res/v1/images/search
SEARCH_RESULT_COUNT=20
CRAWL_USER_AGENT=FIAResearchBot/0.3 (+https://github.com/AryanGupta-234/FIA)
CRAWL_TIMEOUT_SECONDS=8
CRAWL_MAX_BYTES=1500000
CRAWL_MAX_PAGES_PER_JOB=8
CRAWL_RESPECT_ROBOTS=true
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_INTERVAL_MINUTES=360
AUTO_REFRESH_POLL_SECONDS=60

PRICE_STALE_AFTER_HOURS=72
PRICE_ALERT_COOLDOWN_HOURS=24
MIN_PRICE_ALERT_DROP_PERCENT=2.0
